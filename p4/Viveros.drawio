        <mxCell id="O8dUfd_Tq_MviKR9pid9-20" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;Aquí he puesto como PK una ID porque si pusiese como PK los atributos ID de empleado y puesto, solo podria tener una fila por empleado y puesto, y eso en un historico no tiene sentido.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Un empleado podria hacer de camarero dos meses, luego hacer de cocinero 1 mes y luego volver a ser cocinero.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="239" x="-22" y="823" as="geometry" />
        </mxCell>
        <mxCell id="RPHWQkGeoZ_XWBSqJna8-1" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Permitir el histórico, es añadir Fecha_inicio a clave primaria para hacer posible que empleado repita misma tarea en el futuro sin provocar duplicados de clave." vertex="1">
          <mxGeometry height="101" width="239" x="-18" y="322" as="geometry" />
        </mxCell>
        <mxCell id="ouihYx0cdwFl-TJrA9oF-1" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;Tarea debe ser una entidad fuerte, para evitar incongruencias respecto a la relación ternaria y este modelo.&lt;/div&gt;&lt;div&gt;Puede existir tarea definida sin empleado realizándola o asociada a una zona.&lt;/div&gt;" vertex="1">
          <mxGeometry height="82" width="239" x="521.78" y="428" as="geometry" />
        </mxCell>
